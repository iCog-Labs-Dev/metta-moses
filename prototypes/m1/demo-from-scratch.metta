;; ============================================================================
;; demo-from-scratch.metta -- what happens with NO starting program at all.
;;
;;   ( ulimit -v 8000000; timeout 900 \
;;       sh /home/yab/PeTTaV1/run.sh prototypes/m1/demo-from-scratch.metta -s )
;;
;; demo.metta starts from a program that is wrong but well-shaped. This one
;; starts from nothing, which is the honest test of what the machinery can do
;; on its own -- and the whole answer turns on what it is OFFERED.
;; ============================================================================
!(import! &self prototypes/m1/all)

(= (line) "--------------------------------------------------------------")
(= (emptyProgram) (mkTree (mkNode and_seq) ()))
(= (eRep) (buildRep (emptyProgram)))
(= (nKnobs) (knobCountOf (eRep)))

;; the program a single knob gives, and what it is worth
(= (onlyKnob $k) (setNth (defaultInstance (eRep)) $k 1))
(= (eachProgram) (map-atom (rangeTo (nKnobs)) $k (showTree (candidateOf (eRep) (onlyKnob $k)))))
(= (eachScore)   (map-atom (rangeTo (nKnobs)) $k (m1Score (eRep) (onlyKnob $k))))

;; the score after each accepted move, so "how fast" is visible
(= (trajectory $rep $mults $inst $score $fuel)
   (if (<= $fuel 0)
       ($score)
       (let ($ni $ns) (climbStep m1ScoreExp $rep $mults $inst $score)
         (if (== $ns $score)
             ($score)
             (cons-atom $score (trajectory $rep $mults $ni $ns (- $fuel 1)))))))

(= (scoreTrail $rep)
   (let* (($m (multsOf $rep))
          ($d (defaultInstance $rep)))
     (trajectory $rep $m $d (m1Score $rep $d) 20)))

;; every program that never looks: sequences of GRAB/STEP up to length 3
(= (m1Acts) ((mkTree (mkNode m1Grab) ()) (mkTree (mkNode m1Step) ())))
(= (m1Seqs $n)
   (if (<= $n 0) (())
       (let $tails (m1Seqs (- $n 1))
         (foldl-atom (m1Acts) () $acc $a
           (union-atom $acc (map-atom $tails $t (cons-atom $a $t)))))))
(= (blindScores)
   (let $all (union-atom (m1Seqs 1) (union-atom (m1Seqs 2) (m1Seqs 3)))
     (map-atom $all $kids (m1ScoreExp (compileTree (mkTree (mkNode and_seq) $kids))))))


!(println! "")
!(println! "==============================================================")
!(println! "  STARTING FROM NOTHING")
!(println! "")
!(println! "  Same creature, same loops of food, same 14 moves. But this")
!(println! "  time the program we begin with is empty -- it does nothing.")
!(println! "==============================================================")
!(println! (starting-program (showTree (emptyProgram))))
!(println! (it-scores (m1ScoreExp (compileTree (emptyProgram)))))

!(println! "")
!(println! (line))
!(println! "STEP 1.  What is on offer?")
!(println! (line))
!(println! (knobs (nKnobs)))
!(println! (settings (multsOf (eRep))))
!(println! "  An empty sequence has nothing inside it to adjust, so every")
!(println! "  knob here is a place to GROW: one knob per candidate, each")
!(println! "  offering to add that candidate or leave it out.")
!(println! (each-knob-on-its-own (eachProgram)))
!(println! (and-what-each-is-worth (eachScore)))

!(println! "")
!(println! (line))
!(println! "STEP 2.  Run the search.")
!(println! (line))
!(println! (found (let ($i $s) (searchBest m1ScoreExp (eRep))
                    (showTree (candidateOf (eRep) $i)))))
!(println! (score (let ($i $s) (searchBest m1ScoreExp (eRep)) $s)))
!(println! (score-after-each-accepted-move (scoreTrail (eRep))))
!(println! "  One move, from nothing to the best score the world allows.")

!(println! "")
!(println! (line))
!(println! "STEP 3.  Why one move was enough.")
!(println! (line))
!(println! "  Because the conditional was offered COMPLETE. Building it")
!(println! "  needed three decisions at once -- the test and both branches")
!(println! "  -- and the types said what each of them had to be, so it was")
!(println! "  assembled before the search ever saw it:")
!(println! (the-winning-candidate (showTree (index-atom (permsFor and_seq Act) 3))))
!(println! "  The search only had to say yes.")

!(println! "")
!(println! (line))
!(println! "STEP 4.  What it would have faced without that.")
!(println! (line))
!(println! "  Suppose only bare primitives were on offer. Two walls, and")
!(println! "  neither has anything to do with how hard the search tries.")
!(println! "")
!(println! "  A VALLEY. Grab-then-step is worth more than doing nothing,")
!(println! "  but it takes two additions to get there and the first one")
!(println! "  alone is a loss:")
!(println! (adding-grab-alone (m1ScoreExp (quote (and_seq ((m1Grab ())))))))
!(println! (adding-step-alone (m1ScoreExp (quote (and_seq ((m1Step ())))))))
!(println! (but-both-together (m1ScoreExp (quote (and_seq ((m1Grab ()) (m1Step ())))))))
!(println! "  A search that only accepts improvements cannot cross that.")
!(println! "")
!(println! "  And a CEILING behind it. Every program built only from GRAB")
!(println! "  and STEP is capped at 2, because none of them ever LOOKS:")
!(println! (how-many-such-programs-checked (size-atom (blindScores))))
!(println! (best-of-every-grab-step-program (maxOf (blindScores))))
!(println! "  So even crossing the valley would not have been enough. To")
!(println! "  beat 2 a conditional has to appear, and no arrangement of")
!(println! "  primitives is a conditional.")

!(println! "")
!(println! "==============================================================")
!(println! "  WHAT THIS SHOWS")
!(println! "")
!(println! "  From an empty start the bottleneck was never search effort.")
!(println! "  It was what the representation is able to OFFER. Sampling")
!(println! "  candidates that are whole operators -- with their arguments")
!(println! "  filled in by type -- is what turns an unreachable program")
!(println! "  into a single yes-or-no decision.")
!(println! "")
!(println! "  This is the same move classic MOSES makes when it builds")
!(println! "  if-then-else templates rather than offering bare actions,")
!(println! "  and the same one it makes for boolean formulas when it")
!(println! "  offers (OR A B) alongside A and B.")
!(println! "")
!(println! "  What is still missing is the valley: one hill climb cannot")
!(println! "  cross one. MOSES keeps a POPULATION of programs and returns")
!(println! "  to ones that looked bad. That is listed in README.md under")
!(println! "  what this prototype does not do, and it stays true here --")
!(println! "  the search got past the valley by going around it.")
!(println! "==============================================================")
!(println! "")
