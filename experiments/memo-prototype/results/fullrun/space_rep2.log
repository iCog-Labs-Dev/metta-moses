        getScore(F1, H1),
        >=(H1, B, I1),
        (   I1==true
        ->  param(maxCandOutput, J1),
            'OS.length'(A1, K1),
            <=(J1, K1, L1),
            (   L1==true
            ->  param(maxCandOutput, M1),
                'OS.getTopN'(M1, A1, H)
            ;   H=A1
            )
        ;   -(A, 1, N1),
            runMoses(N1,
                     B,
                     A1,
                     D,
                     E,
                     F,
                     G,
                     H)
        )
    ).
