       (List.repeat (get-state &zipRowCount) $term)
       (let $h (car-atom $term)
         (if (== $h col)
             (let (col $label) $term (varColumn (get-state &zipTable) $label))
             (if (== $h zipWith1)
                 (let (zipWith1 $f $c) $term
                   (map-atom ($eval $c) $v ($f $v)))
                 (if (== $h zipWith)
                     (let (zipWith $f $a $b) $term
                       (List.zipWith $f ($eval $a) ($eval $b)))
                     (if (== $h zipWithN)
                         (let (zipWithN $op $children) $term
                           (let $cols (map-atom $children $c ($eval $c))
                             (map-atom (transposeCols $cols) $row ($op $row))))
                         (Error $term "evalZipTermCore: unknown zip-term head"))))))))
[33m--> prolog clause -->
[32mevalZipTermCore(A, B, C) :-
    'get-metatype'(A, D),
    ==(D, 'Grounded', E),
    (   E==true
    ->  'get-state'('&zipRowCount', F),
        'List.repeat'(F, A, C)
    ;   G=H,
        'car-atom'(A, H),
        ==(G, col, I),
        (   I==true
        ->  A=[col, J],
            'get-state'('&zipTable', K),
            varColumn(K, J, C)
        ;   ==(G, zipWith1, L),
            (   L==true
            ->  A=[zipWith1, M, N],
                reduce([B, N], O),
                maplist([P, Q]>>(reduce([M, P], R), (number(R)->Q is R;Q=R)),
                        O,
                        C)
            ;   ==(G, zipWith, S),
                (   S==true
                ->  A=[zipWith, M, T, U],
                    reduce([B, T], V),
                    reduce([B, U], W),
                    'List.zipWith'(M, V, W, C)
                ;   ==(G, zipWithN, X),
                    (   X==true
                    ->  A=[zipWithN, Y, Z],
                        A1=B1,
                        maplist([N, C1]>>(reduce([B, N], D1), (number(D1)->C1 is D1;C1=D1)),
                                Z,
                                B1),
                        transposeCols(A1, E1),
                        maplist([F1, G1]>>(reduce([Y, F1], H1), (number(H1)->G1 is H1;G1=H1)),
                                E1,
                                C)
                    ;   C=['Error', A, "evalZipTermCore: unknown zip-term head"]
                    )
                )
            )
        )
    ).
