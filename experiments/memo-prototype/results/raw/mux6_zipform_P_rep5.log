[0m[33m--> metta function -->
[36m(= (benchCountTrue $col) (foldl-atom $col 0 $acc $b (if (== $b True) (+ $acc 1) $acc)))
[33m--> prolog clause -->
[32mbenchCountTrue(A, B) :-
    foldl([C, D, E]>>((==(C, true, F), (F==true-> +(D, 1, G);G=D)), (number(G)->E is G;E=G)),
          A,
          0,
          B).
[33m^^^^^^^^^^^^^^^^^^^^^^
[0m[33m--> metta function -->
[36m(= (benchGetCandidate $i) (car-atom (collapse (match &replayStream (candidate $i (quote $e)) $e))))
[33m--> prolog clause -->
[32mbenchGetCandidate(A, B) :-
    findall(C,
            match('&replayStream',
                  [candidate, A, [quote, C]],
                  C,
                  C),
            D),
    'car-atom'(D, B).
