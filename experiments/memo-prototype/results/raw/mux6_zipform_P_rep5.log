[0m[33m--> metta function -->
[36m(= (benchLoop $i $n $acc)
   (if (> $i $n)
       $acc
       (let $e (benchGetCandidate $i)
         (let $col (evalZipTerm (rewriteTreeNaryCached $e))
           (benchLoop (+ $i 1) $n (+ $acc (benchCountTrue $col)))))))
[33m--> prolog clause -->
[32mbenchLoop(A, B, C, D) :-
    >(A, B, E),
    (   E==true
    ->  D=C
    ;   F=G,
        benchGetCandidate(A, G),
        H=I,
        cache_call(rewriteTreeNaryCached, [F], J),
        cache_call(evalZipTerm, [J], I),
        +(A, 1, K),
        benchCountTrue(H, L),
        +(C, L, M),
        benchLoop(K, B, M, D)
    ).
