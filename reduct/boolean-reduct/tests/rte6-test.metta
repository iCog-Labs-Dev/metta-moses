!(import! &self ../../../utilities/general-helpers)
!(import! &self ../rte-helpers)
!(import! &self ../cut-unnecessary-or)
!(import! &self ../cut-unnecessary-and)
!(import! &self ../delete-inconsistent-handle)
!(import! &self ../zero-constraint-subsumption)
!(import! &self ../one-constraint-subsumption)
!(import! &self ../promote-common-constraints)
!(import! &self ../reduce-to-elegance)
!(import! &self ../../../scoring/boolean-ops) ;; mirrors moses.metta: AND/OR/NOT become callable AFTER the reduct compiles

;; (AND (OR (NOT A) (AND A B C) (AND B C (NOT B)))) ==> (AND (OR (AND (NOT A)) (AND A B C)))
!(assertEqual (reduceToElegance (quote (AND (OR (AND (NOT $A)) (AND $A $B $C) (AND $B $C (NOT $B))))) (quote (OR (AND (NOT $A)) (AND $A $B $C) (AND $B $C (NOT $B)))) () ()) (quote ((AND (OR (AND (NOT $A)) (AND $A $B $C))) (OR (AND (NOT $A)) (AND $A $B $C)) False)))
;; (AND (OR (NOT A) (AND A B C) (AND B C (NOT B)))) ==> (AND (OR (NOT A) (AND A B C)))
!(assertEqual (reduceToElegance (quote (AND (OR (NOT $A) (AND $A $B $C) (AND $B $C (NOT $B))))) (quote (OR (NOT $A) (AND $A $B $C) (AND $B $C (NOT $B)))) () ()) (quote ((AND $B $C (OR (NOT $A) (AND $A) (AND (NOT $B)))) (OR (NOT $A) (AND $A) (AND (NOT $B))) True)))
;; (AND (OR (NOT A) (AND A B C) (AND C B (NOT B)))) ==> (AND (OR (NOT A ) (AND A B C)))
!(assertEqual (reduceToElegance (quote (AND (OR (NOT $A) (AND $A $B $C) (AND $C $B (NOT $B))))) (quote (OR (NOT $A) (AND $A $B $C) (AND $C $B (NOT $B)))) () ()) (quote ((AND $B $C (OR (NOT $A) (AND $A) (AND (NOT $B)))) (OR (NOT $A) (AND $A) (AND (NOT $B))) True)))
;; (AND (OR (AND C A D) (AND C A) (AND C A E))) ==> (AND C A)
!(assertEqual (reduceToElegance (quote (AND (OR (AND $C $A $D) (AND $C $A) (AND $C $A $E)))) (quote (OR (AND $C $A $D) (AND $C $A) (AND $C $A $E))) () ()) (quote ((AND $C $A (OR (AND $D) (AND $E))) (OR (AND $D) (AND $E)) true))) ;; FIX: Classic says this should be: (AND (OR (AND D E) A) C)
;; (AND (OR (AND A B) (AND A C D) (AND A C E) (AND C A))) ==> (AND A (OR B (AND C D) (AND C E) C))
!(assertEqual (reduceToElegance (quote (AND (OR (AND $A $B) (AND $A $C $D) (AND $A $C $E) (AND $C $A)))) (quote (OR (AND $A $B) (AND $A $C $D) (AND $A $C $E) (AND $C $A))) () ()) (quote ((AND $A (OR (AND $B) (AND $C $D) (AND $C $E) (AND $C))) (OR (AND $B) (AND $C $D) (AND $C $E) (AND $C)) True)))
