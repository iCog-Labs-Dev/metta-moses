!(import! &self ../../../utilities/general-helpers)
!(import! &self ../rte-helpers)
!(import! &self ../cut-unnecessary-or)
!(import! &self ../cut-unnecessary-and)
!(import! &self ../delete-inconsistent-handle)
!(import! &self ../zero-constraint-subsumption)
!(import! &self ../one-constraint-subsumption)
!(import! &self ../promote-common-constraints)
!(import! &self ../reduce-to-elegance)
!(import! &self ../../../scoring/boolean-ops) ;; mirrors moses.metta: AND/OR/NOT become callable AFTER the reduct compiles


;; (AND A B C D (NOT B)) ==> (AND)
!(assertEqual (reduceToElegance (quote (AND (AND $A $B $C $D (NOT $B)))) (quote (AND $A $B $C $D (NOT $B))) () ()) (quote ((AND) (AND) False)))
;; (AND B (NOT C) (NOT A) (OR B (NOT A))) ==> (AND B (NOT C) (NOT A))
!(assertEqual (reduceToElegance (quote (AND (AND $B (NOT $C) (NOT $A) (OR $B (NOT $A))))) (quote (AND $B (NOT $C) (NOT $A) (OR $B (NOT $A)))) () ()) (quote ((AND (AND $B (NOT $C) (NOT $A) (OR $B (NOT $A)))) (AND $B (NOT $C) (NOT $A) (OR $B (NOT $A))) False)))
;; (AND B (NOT C) (NOT A) (OR B (AND (NOT K) (NOT X)))) ==> (AND B (NOT C) (NOT A))
!(assertEqual (reduceToElegance (quote (AND (AND $B (NOT $C) (NOT $A) (OR (AND $B) (AND (NOT $K) (NOT $X)))))) (quote (AND $B (NOT $C) (NOT $A) (OR (AND $B) (AND (NOT $K) (NOT $X))))) () ()) (quote ((AND (AND $B (NOT $C) (NOT $A))) (AND $B (NOT $C) (NOT $A)) False)))
;; (AND (NOT A) (NOT C) B (OR (NOT B) (NOT A))) ==> (AND (NOT A) (NOT C) B)
!(assertEqual (reduceToElegance (quote (AND (AND (NOT $A) (NOT $C) $B (OR (AND (NOT $B)) (AND (NOT $A)))))) (quote (AND (NOT $A) (NOT $C) $B (OR (AND (NOT $B)) (AND (NOT $A))))) () ()) (quote ((AND (AND (NOT $A) (NOT $C) $B)) (AND (NOT $A) (NOT $C) $B) False)))
;; (AND B (NOT C) (NOT A) (OR (NOT B) (NOT C) (NOT D) (NOT A))) ==> (AND B (NOT C) (NOT A))
!(assertEqual (reduceToElegance (quote (AND (AND $B (NOT $C) (NOT $A) (OR (NOT $B) (NOT $C) (NOT $D) (NOT $A))))) (quote (AND $B (NOT $C) (NOT $A) (OR (NOT $B) (NOT $C) (NOT $D) (NOT $A)))) () ()) (quote ((AND (AND $B (NOT $C) (NOT $A) (OR (NOT $B) (NOT $C) (NOT $D) (NOT $A)))) (AND $B (NOT $C) (NOT $A) (OR (NOT $B) (NOT $C) (NOT $D) (NOT $A))) False)))
;; (AND A B C B A A (NOT A) (OR A B C A)) ==> (AND)
!(assertEqual (reduceToElegance (quote (AND (AND $A $B $C $B $A $A (NOT $A) (OR $A $B $C $A)))) (quote (AND $A $B $C $B $A $A (NOT $A) (OR $A $B $C $A))) () ()) (quote ((AND) (AND) False)))
;; (AND (OR A B)) ==> (AND (OR A B))
!(assertEqual (reduceToElegance (quote (AND (OR $A $B))) (quote (OR $A $B)) () ()) (quote ((AND (OR $A $B)) (OR $A $B) False)))
;; (AND (OR A A)) ==> (AND A)
!(assertEqual (reduceToElegance (quote (AND (OR $A $A))) (quote (OR $A $A)) () ()) (quote ((AND (OR $A $A)) (OR $A $A) False))) ;; ((AND A) () False)
;; (AND (OR (AND A B) A C)) ==> (AND (OR (AND A B) A C))
!(assertEqual (reduceToElegance (quote (AND (OR (AND $A $B) $A $C))) (quote (OR (AND $A $B) $A $C)) () ()) (quote ((AND $A $B $C) () True)))
;; (AND (OR (AND A B) (AND A B))) ==> (AND A B)
!(assertEqual (reduceToElegance (quote (AND (OR (AND $A $B) (AND $A $B)))) (quote (OR (AND $A $B) (AND $A $B))) () ()) (quote ((AND $A $B) () True)))
;; (AND (OR (AND A B) C D)) ==> (AND (OR (AND A B) C D))
!(assertEqual (reduceToElegance (quote (AND (OR (AND $A $B) $C $D))) (quote (OR (AND $A $B) $C $D)) () ()) (quote ((AND $A $B (OR $C $D)) (OR $C $D) True)))
;; (AND (OR (NOT A) (NOT C) (NOT D))) ==> (AND (OR (NOT A) (NOT C) (NOT D)))
!(assertEqual (reduceToElegance (quote (AND (OR (NOT $A) (NOT $C) (NOT $D)))) (quote (OR (NOT $A) (NOT $C) (NOT $D))) () ()) (quote ((AND (OR (NOT $A) (NOT $C) (NOT $D))) (OR (NOT $A) (NOT $C) (NOT $D)) False)))
;; (AND (OR (AND A (OR (NOT B) (NOT C))) D)) ==> (AND (OR (AND A (OR (NOT B) (NOT C))) D))
!(assertEqual (reduceToElegance (quote (AND (OR (AND $A (OR (NOT $B) (NOT $C))) $D))) (quote (OR (AND $A (OR (NOT $B) (NOT $C))) $D)) () ()) (quote ((AND $A (OR $D (NOT $B) (NOT $C))) (OR $D (NOT $B) (NOT $C)) True))) ;; FIX: Classic says this should be (OR (AND (OR (NOT B) (NOT C)) A) D)
;; (AND (OR A B C D C)) ==> (AND (OR A B C D C))
!(assertEqual (reduceToElegance (quote (AND (OR $A $B $C $D $C))) (quote (OR $A $B $C $D $C)) () ()) (quote ((AND (OR $A $B $C $D $C)) (OR $A $B $C $D $C) False)))
;; (AND (OR A (AND B C D C))) ==> (AND (OR A (AND B C D C)))
!(assertEqual (reduceToElegance (quote (AND (OR $A (AND $B $C $D $C)))) (quote (OR $A (AND $B $C $D $C))) () ()) (quote ((AND $B $C $D $A) () True)))
;; (AND (OR (NOT C) (NOT D) (AND (NOT A) B))) ==> (AND (OR (NOT C) (NOT D) (AND (NOT A) B)))
!(assertEqual (reduceToElegance (quote (AND (OR (NOT $C) (NOT $D) (AND (NOT $A) $B)))) (quote (OR (NOT $C) (NOT $D) (AND (NOT $A) $B))) () ()) (quote ((AND (NOT $A) $B (OR (NOT $C) (NOT $D))) (OR (NOT $C) (NOT $D)) true)))
;; (AND (OR A B C D (NOT C))) ==> (AND (OR A B C D (NOT C)))
!(assertEqual (reduceToElegance (quote (AND (OR $A $B $C $D (NOT $C)))) (quote (OR $A $B $C $D (NOT $C))) () ()) (quote ((AND (OR $A $B $C $D (NOT $C))) (OR $A $B $C $D (NOT $C)) False)))
;; (AND (OR (AND A B) (AND A C) (AND A D))) ==> (AND A (OR B C D))
!(assertEqual (reduceToElegance (quote (AND (OR (AND $A $B) (AND $A $C) (AND $A $D)))) (quote (OR (AND $A $B) (AND $A $C) (AND $A $D))) () ()) (quote ((AND $A (OR (AND $B) (AND $C) (AND $D))) (OR (AND $B) (AND $C) (AND $D)) True)))
;; (AND (OR (AND A B) (AND A C (OR D (AND E A))))) ==> (AND A (OR B (AND C (OR D E))))
!(assertEqual (reduceToElegance (quote (AND (OR (AND $A $B) (AND $A $C (OR (AND $D) (AND $E $A)))))) (quote (OR (AND $A $B) (AND $A $C (OR (AND $D) (AND $E $A))))) () ()) (quote ((AND $A (OR (AND $B) (AND $C (OR (AND $D) (AND $E $A))))) (OR (AND $B) (AND $C (OR (AND $D) (AND $E $A)))) True)))  ;; INFO: This test case fails bec(reduceToElegance (AND (OR (AND A B) (AND A C (OR (AND D) (AND E) (AND A))))) (OR (AND A B) (AND A C (OR (AND D) (AND E) (AND A)))) () ())uase RTE needs to be called again if the parent chang ed
!(assertEqual (reduceToElegance (quote (AND (AND $A (OR (AND $B) (AND $C (OR (AND $D) (AND $E $A))))))) (quote (AND $A (OR (AND $B) (AND $C (OR (AND $D) (AND $E $A)))))) () ()) (quote ((AND (AND $A (OR (AND $B) (AND $C (OR (AND $D) (AND $E)))))) (AND $A (OR (AND $B) (AND $C (OR (AND $D) (AND $E))))) False)))


